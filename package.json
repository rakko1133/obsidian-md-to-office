{
  "name": "batch-office-export",
  "version": "0.0.1",
  "description": "Batch-convert notes to Word (.docx) and Excel (.xlsx), with Mermaid diagrams as images.",
  "private": true,
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build:dev": "node esbuild.config.mjs once",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "deploy:test-vault": "node scripts/deploy-test-vault.mjs"
  },
  "dependencies": {
    "docx": "^9.15.4",
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "jszip": "^3.10.2",
    "obsidian": "^1.14.4",
    "tslib": "^2.9.1",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
