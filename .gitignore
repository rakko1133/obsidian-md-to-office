# 依存（package-lock.json から再生成できる）
node_modules/

# ビルド成果物（配布は GitHub Releases に添付する）
main.js
*.map
dist/
coverage/

# Obsidian の操作状態・個人の設定値
.obsidian/workspace*.json
data.json

# 変換結果（実行のたびに生成されるバイナリ）
test-vault/**/_export/
*.docx
*.xlsx
~$*
# 変換結果の確認用の PDF・PNG・一覧ページ（npm run preview:export で生成。基準画像も各自の環境のフォントで描画されるため入れない）
.preview/

# 機密
.env
.env.*

# エディタ・OS・Claude Code の個人設定
.vscode/
.DS_Store
Thumbs.db
.claude/settings.local.json

# Obsidian に入れた他者製のプラグイン本体（main.js は上の規則で除外済み。残りだけ入れても動かないため、フォルダごと除外）
.obsidian/plugins/

# テスト用 Vault: Obsidian の操作状態と、配置したプラグイン本体（npm run deploy:test-vault でコピーする）
test-vault/.obsidian/*
!test-vault/.obsidian/community-plugins.json
